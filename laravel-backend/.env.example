APP_NAME="KONI Kota Bandung - PORPROV XV Jabar 2026"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://monitoring.konikotabandung.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MySQL / PostgreSQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koni_bandung_porprov2026
DB_USERNAME=koni_dbuser
DB_PASSWORD=SecurePasswordKoni2026!

# Atau gunakan SQLite untuk setup instan:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=koni_porprov2026_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@konikotabandung.id"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend SPA Origin for CORS
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,monitoring.konikotabandung.id
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://monitoring.konikotabandung.id
